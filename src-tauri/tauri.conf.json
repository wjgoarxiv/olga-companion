{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OLGA Companion",
  "version": "0.1.33",
  "identifier": "com.woojoon.olga-companion",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OLGA Companion",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8865 http://localhost:8865; font-src 'self' data:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wjgoarxiv/olga-companion/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDQkMxNUMyQkM1OUI5NDYKUldSR3VWbTh3aFc4akNuMTZKUTc1NUY1ell0aythVnpSTVd0Um1qOCtSRWNHTGRmRjFNL2xKeUgK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "publisher": "Woojin Go",
    "shortDescription": "Evidence-backed desktop workbench for OLGA engineering workflows",
    "longDescription": "Inspect cases, supervise approval-gated OLGA runs, and review result evidence from one local Windows workbench.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/olga-companion-sidecar"],
    "resources": {
      "../resources/olga-toolkit/": "resources/olga-toolkit/",
      "../resources/fluids/": "resources/fluids/",
      "../resources/tutorial/": "resources/tutorial/",
      "../resources/examples/": "resources/examples/",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt",
      "../licenses/": "licenses/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  }
}
