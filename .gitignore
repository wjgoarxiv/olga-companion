# Remotion workspace: deps and render output. The GIF the README embeds is
# committed (assets/demo.gif); the full-resolution MP4 is a release asset, not
# repository content.
/video/node_modules/
/video/out/
/assets/demo.mp4

# Brand faces are copied into the Remotion workspace at render time by
# `npm --prefix video run fonts`; the originals live in frontend/public/fonts.
/video/public/fonts/
