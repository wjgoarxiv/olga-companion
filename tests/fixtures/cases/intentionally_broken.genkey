!**************************************************************************************
! Intentionally broken .genkey file for validator testing
! Each error is marked with ! ERROR: <description>
!**************************************************************************************

!**************************************************************************************
! Global keywords
!**************************************************************************************
OPTIONS STEADYSTATE=ON, COMPOSITIONAL=OFF, FLOWMODEL=OLGAHD
CASE AUTHOR=TestUser, PROJECT=BrokenPipeline, TITLE="Intentionally Broken Pipeline", \
        INFO="This file contains deliberate errors for validator testing"
FILES PVTFILE="./dummy_fluid.tab"

! ERROR: Time-stepping error - DTSTART (200 s) > MAXDT (100 s)
INTEGRATION ENDTIME=24 h, MAXDT=100 s, MINDT=0.001 s, STARTTIME=0 s, DTSTART=200 s

OUTPUT DTOUT=3600 s
TREND DTPLOT=300 s
PROFILE DTPLOT=3600 s

!**************************************************************************************
! Library keywords
!**************************************************************************************
MATERIAL LABEL="Steel", CAPACITY=0.11 Btu/lbm-F, CONDUCTIVITY=27.0 Btu/ft-h-R, \
        DENSITY=489.0 lb/ft3, TYPE=SOLID

! ERROR: Dangling material reference - references "NonExistent_Material" which is never defined
WALL LABEL="Steel_Wall", THICKNESS=(0.01, 0.05) m, MATERIAL=("Steel", "NonExistent_Material")

!**************************************************************************************
! Network Component - FLOWPATH with multiple pipe errors
!**************************************************************************************
NETWORKCOMPONENT TYPE=FLOWPATH, TAG=FLOWPATH_1
 PARAMETERS LABEL="Broken_Pipeline"
 BRANCH FLUID=1
 GEOMETRY LABEL="G-Broken", XSTART=0 m, YSTART=0 m, ZSTART=0 m

 ! ERROR: Negative pipe diameter - DIAMETER=-0.5 ft is physically invalid
 PIPE LABEL=Pipe_1, WALL="Steel_Wall", ROUGHNESS=2.5e-05 m, NSEGMENT=2, \
        LSEGMENT=(50, 50) m, XEND=100 m, YEND=0 m, ZEND=0 m, \
        DIAMETER=-0.5 ft

 ! ERROR: Zero pipe length - LSEGMENT=(0, 0) produces zero-length segments
 PIPE LABEL=Pipe_2, WALL="Steel_Wall", ROUGHNESS=2.5e-05 m, NSEGMENT=2, \
        LSEGMENT=(0, 0) m, XEND=100 m, YEND=0 m, ZEND=0 m, \
        DIAMETER=0.3 m

 ! ERROR: Dangling wall reference - "Ghost_Wall" is never defined in WALL section
 PIPE LABEL=Pipe_3, WALL="Ghost_Wall", ROUGHNESS=2.5e-05 m, NSEGMENT=2, \
        LSEGMENT=(50, 50) m, XEND=200 m, YEND=0 m, ZEND=0 m, \
        DIAMETER=0.3 m

 OUTPUTDATA VARIABLE=(PT, TM, HOL, QT)
ENDNETWORKCOMPONENT

! ERROR: Disconnected topology - FLOWPATH_2 has no CONNECTION to any node
NETWORKCOMPONENT TYPE=FLOWPATH, TAG=FLOWPATH_2
 PARAMETERS LABEL="Orphan_Pipeline"
 BRANCH FLUID=1
 GEOMETRY LABEL="G-Orphan", XSTART=500 m, YSTART=0 m, ZSTART=0 m
 ! ERROR: Empty NETWORKCOMPONENT - FLOWPATH_2 has no PIPE definitions
ENDNETWORKCOMPONENT

!**************************************************************************************
! Network Component - NODES
!**************************************************************************************
! ERROR: Missing boundary condition - both nodes are CLOSED, so no pressure BC exists
!        anywhere in the network; simulation cannot determine flow direction or magnitude
NETWORKCOMPONENT TYPE=NODE, TAG=NODE_INLET
 PARAMETERS LABEL="Inlet_Node", TYPE=CLOSED, X=0 m, Y=0 m, Z=0 m
ENDNETWORKCOMPONENT

NETWORKCOMPONENT TYPE=NODE, TAG=NODE_OUTLET
 PARAMETERS LABEL="Outlet_Node", TYPE=CLOSED, X=200 m, Y=0 m, Z=0 m
ENDNETWORKCOMPONENT

!**************************************************************************************
! Connections
!**************************************************************************************
CONNECTION TERMINALS = (NODE_INLET FLOWTERM_1, FLOWPATH_1 INLET)
CONNECTION TERMINALS = (NODE_OUTLET FLOWTERM_1, FLOWPATH_1 OUTLET)
! NOTE: FLOWPATH_2 intentionally has no connections (disconnected topology error above)

! ERROR: Missing ENDCASE - file ends without the required ENDCASE keyword
