! Deterministic CaseSpec v2 compilation
OPTIONS STEADYSTATE=ON, COMPOSITIONAL=OFF, FLOWMODEL=OLGAHD, TEMPERATURE=ADIABATIC
CASE AUTHOR=OLGACOMPANION, PROJECT=CASESPEC, TITLE="CaseSpec v2"
FILES PVTFILE="fluid.tab"
INTEGRATION ENDTIME=3600 s, MINDT=0.001 s, STARTTIME=0 s, DTSTART=1 s
OUTPUT DTOUT=3600 s
TREND DTPLOT=60 s
PROFILE DTPLOT=900 s
NETWORKCOMPONENT TYPE=FLOWPATH, TAG=MAIN
 PARAMETERS LABEL="MAIN"
 BRANCH FLUID="TEST_FLUID"
 GEOMETRY LABEL="G-MAIN", XSTART=0 m, YSTART=0 m, ZSTART=0 m
 PIPE LABEL=PIPE_A, ROUGHNESS=0.00005 m, NSEGMENT=10, LSEGMENT=(10,10,10,10,10,10,10,10,10,10) m, XEND=100 m, YEND=0 m, ZEND=0 m, DIAMETER=0.1 m
 POSITION LABEL="POS_FEED", PIPE=PIPE_A, SECTION=1
 SOURCE LABEL="FEED", POSITION="POS_FEED", TIME=(0) s, MASSFLOW=(1) kg/s, TEMPERATURE=(40) C, GASFRACTION=(0.25) -, TOTALWATERFRACTION=(0) -
 POSITION LABEL="POS_MAIN_1", PIPE=PIPE_A, SECTION=1
 POSITION LABEL="POS_MAIN", PIPE=PIPE_A, SECTION=10
 OUTPUTDATA VARIABLE=(PT, TM)
 PROFILEDATA VARIABLE=(PT, TM)
 TRENDDATA POSITION=(POS_MAIN_1, POS_MAIN), VARIABLE=(PT, TM)
ENDNETWORKCOMPONENT
NETWORKCOMPONENT TYPE=NODE, TAG=SINK
 PARAMETERS LABEL="SINK", TYPE=PRESSURE, X=100 m, Y=0 m, Z=0 m, PRESSURE=1000000 Pa, TEMPERATURE=30 C, GASFRACTION=0.15 -, TOTALWATERFRACTION=0.35 -, TIME=0 s, FLUID="TEST_FLUID"
ENDNETWORKCOMPONENT
NETWORKCOMPONENT TYPE=NODE, TAG=SOURCE
 PARAMETERS LABEL="SOURCE", TYPE=PRESSURE, X=0 m, Y=0 m, Z=0 m, PRESSURE=2000000 Pa, TEMPERATURE=40 C, GASFRACTION=0.2 -, TOTALWATERFRACTION=0.4 -, TIME=0 s, FLUID="TEST_FLUID"
ENDNETWORKCOMPONENT
CONNECTION TERMINALS = (SOURCE FLOWTERM_1, MAIN INLET)
CONNECTION TERMINALS = (SINK FLOWTERM_1, MAIN OUTLET)
ENDCASE
