  "acceptance_criteria": [
    {
      "id": "criterion:five-stages",
      "observable": "All five stages expose task descriptions and evidence checkpoints without claiming completion",
      "verification": "tests",
      "required": true,
      "inventory_ids": [
        "component:guide"
      ]
    },
    {
      "id": "criterion:manual-send",
      "observable": "Preparing a question changes only the multiline composer value and focus; no chat or approval request is sent; existing drafts are preserved",
      "verification": "browser",
      "required": true,
      "inventory_ids": [
        "interaction:prepare-question",
        "component:question"
      ]
    },
    {
      "id": "criterion:edit-question",
      "observable": "Long Korean drafts wrap; Enter adds a line; Clear empties only the draft; IME and whitespace cannot trigger submission; Ctrl/Command+Enter submits once",
      "verification": "browser",
      "required": true,
      "inventory_ids": [
        "interaction:clear-question",
        "interaction:send-question",
        "component:question"
      ]
    },
    {
      "id": "criterion:recovery",
      "observable": "Missing case, missing provider and offline state explain the next action",
      "verification": "browser",
      "required": true,
      "inventory_ids": [
        "interaction:recover",
        "state:no-case",
        "state:no-provider",
        "state:offline"
      ]
    },
    {
      "id": "criterion:keyboard",
      "observable": "Disclosure, step selection and preparation work with keyboard and show focus",
      "verification": "keyboard",
      "required": true,
      "inventory_ids": [
        "component:guide",
        "component:question"
      ]
    },
    {
      "id": "criterion:rs-matrix",
      "observable": "Attempt the full installed probe matrix; no remaining measured or derived HIGH findings; exit 2 remains blocked",
      "verification": "browser",
      "required": true,
      "inventory_ids": [
        "route:chat"
      ]
    },
    {
      "id": "criterion:run-truth",
      "observable": "A receipt from an earlier session is labelled as history with no live progress; Approve names what blocks it; a failed run shows fault lines and a next step without automatic retry",
      "verification": "browser",
      "required": true,
      "inventory_ids": [
        "state:run-history-receipt",
        "state:approve-blocked",
        "component:run-approve"
      ]
    },
    {
      "id": "criterion:result-truth",
      "observable": "Each result is labelled receipt-verified, changed after the run, or receipt-less; chart text is at least 12px; selection changes clear export receipts",
      "verification": "browser",
      "required": true,
      "inventory_ids": [
        "state:result-receipt-verified",
        "state:result-receipt-changed",
        "component:trend-chart"
      ]
    },
    {
      "id": "criterion:stale-chat",
      "observable": "A slow earlier chat load, create or delete never replaces the conversation the user is looking at",
      "verification": "tests",
      "required": true,
      "inventory_ids": [
        "interaction:switch-chat",
        "component:session-menu"
      ]
    }
  ]
}
