  "contract_id": "contract:beginner-journey",
  "source_hash": "24315cb442e2e8de53c36c56e815f23b9ae24a5468fde1a39bf89256ba117483",
  "lane": "brownfield",
  "intent": {
    "audiences": [
      "Korean-speaking OLGA beginners"
    ],
    "tasks": [
      "Define, create, modify, validate, approve, run, plot and analyze a case"
    ],
    "qualities": [
      "Understandable next action",
      "Evidence before engineering claims",
      "Explicit human approval"
    ],
    "constraints": [
      "Preserve existing worktree changes and local fonts",
      "Reuse the light React workbench",
      "No typed filesystem paths",
      "Do not transmit a guide question without manual Send"
    ],
    "non_goals": [
      "Release or signing",
      "Fabricated simulation success",
      "Replacement of the simulation engine",
      "Global UI translation"
    ]
  },
  "direction": {
    "name": "Guided engineering workbench",
    "principles": [
      "One ordered task list, not five competing cards",
      "Prepare editable questions before sending",
      "Expose recovery actions for missing prerequisites",
      "Show evidence checkpoints without inventing completion"
    ],
    "token_strategy": "reuse",
    "voice": "Plain Korean verbs with existing English navigation names where necessary"
  },
