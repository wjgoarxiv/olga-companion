      "interaction_ids": [
        "interaction:preview-run",
        "interaction:approve-run",
        "interaction:stop-run"
      ],
      "keyboard_behavior": "Native buttons; Approve is disabled until a preview passes and names the blocker through aria-describedby; no automatic retry"
    },
    {
      "component_id": "component:run-receipt",
      "state_ids": [
        "state:run-history-receipt",
        "state:run-failed"
      ],
      "interaction_ids": [
        "interaction:open-result"
      ],
      "keyboard_behavior": "A restored receipt is labelled as earlier history and shows no live progress; the raw log is a native disclosure"
    },
