    },
    {
      "route_id": "route:chat",
      "viewport_id": "viewport:tablet",
      "behavior": "Let content fit the workbench without horizontal document overflow"
    },
    {
      "route_id": "route:chat",
      "viewport_id": "viewport:desktop",
