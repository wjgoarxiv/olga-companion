{
  "name": "olga-companion",
  "version": "0.1.32",
  "description": "OLGA multiphase flow tools without the desktop app: review and edit cases, make fluid tables, run OLGA and read results. Writes always go to new files, and Claude Code asks before each one.",
  "author": {
    "name": "wjgoarxiv",
    "url": "https://github.com/wjgoarxiv"
  },
  "homepage": "https://github.com/wjgoarxiv/olga-companion",
