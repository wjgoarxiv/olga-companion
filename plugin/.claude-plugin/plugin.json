  "license": "Apache-2.0",
  "keywords": ["olga", "flow-assurance", "multiphase", "pipeline", "simulation"],
  "mcpServers": {
    "olga-companion": {
      "command": "uvx",
      "args": ["--from", "olga-companion[results] @ git+https://github.com/wjgoarxiv/olga-companion@v0.1.32", "olga-companion-mcp"]
    }
  }
}
